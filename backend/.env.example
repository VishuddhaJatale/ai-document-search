# Required: create a key at https://console.groq.com and keep it private.
GROQ_API_KEY=your_groq_api_key_here

# LLM and embedding models
GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Document processing and retrieval
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=6
MAX_CONTEXT_CHARS=12000
MAX_UPLOAD_MB=10
MIN_RELEVANCE_SCORE=0.0
USE_MMR=false
RETRIEVAL_MODE=hybrid

# API request limits (per client IP, in-memory, single backend process)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Frontend origins allowed to call this backend
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Disable anonymous Chroma telemetry
ANONYMIZED_TELEMETRY=False
